# ===================================================================
# TalentCore Example Environment Configuration Template
# Copy this file to .env and replace with your local credentials
# ===================================================================

# Application Server
SERVER_PORT=8085

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talentcore_dev
DB_USERNAME=root
DB_PASSWORD=7693

# Spring Datasource Mappings
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# SMTP / Mail Server (Optional for production alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
